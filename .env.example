# ===== EV Gap India — root/demo environment (copy to .env and tweak) =====
# Frontend (Vite) — base URL of the backend REST API
VITE_API_URL=http://localhost:4000/api

# Open Charge Map API key (charger ingestion; the app runs fine without it)
OCM_API_KEY=

# Optional: data.gov.in / BEE charger dataset resource id + key
DATA_GOV_IN_RESOURCE_ID=
DATA_GOV_IN_API_KEY=
