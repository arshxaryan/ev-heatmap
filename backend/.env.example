# ===== EV Gap India — backend environment =====
PORT=4000
NODE_ENV=development

# SQLite file (Postgres+PostGIS ready in schema/ for production)
DATABASE_FILE=./data/ev-gap.db

# Daily refresh schedule (node-cron format). Comment out to disable.
REFRESH_CRON="30 2 * * *"
# Also refresh once on server boot (handy for demos)
AUTO_REFRESH_ON_START=true

# ---- Charging stations: Open Charge Map (free key: https://openchargemap.org/site/develop/api)
OCM_API_KEY=
OCM_BASE_URL=https://api.openchargemap.io/v3/poi

# ---- EV registrations: Vahan (no official public API — scrape is best-effort; prefer CSV upload)
VAHAN_BASE_URL=https://vahan.parivahan.gov.in/vahan4/dashboard

# Disable auto-seeding on boot if you bring your own database
# SEED=off

# Allowed CORS origins (comma separated) for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
